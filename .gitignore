# Datasets & Downloads (keep untracked; re-download locally anytime with download_dataset.sh)
dataset/
datasets/
train/
valid/
test/
data.yaml
README.dataset.txt
README.roboflow.txt
*.zip
.env

# Ignore raw model binaries by default (prevents pushing stock yolo26l.pt or huge optimizer last.pt)
*.pt
*.onnx
*.engine

# Allow ONLY the trained best checkpoint & training summary inside weights/
weights/*
!weights/best.pt
!weights/training_summary.json

# Keep evaluation reports (comparison_report.md, metrics JSON, side-by-side PNG frames/snapshots)
# reports/ is intentionally tracked!

# Inside runs/, track ONLY plots, CSV logs, and args.yaml (ignore duplicate weights/ & huge debug batches)
runs/*
!runs/detect/
runs/detect/*
!runs/detect/*/
runs/detect/*/*
!runs/detect/*/*.png
!runs/detect/*/*.jpg
!runs/detect/*/*.csv
!runs/detect/*/*.yaml
runs/detect/*/train_batch*.jpg
runs/detect/*/val_batch*.jpg

# Python & Virtualenvs
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
nohup.out
